{
  "name": "pairwizard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^1.13.4",
    "prettier": "^3.2.5"
  },
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=18.0.0"
  }
}
